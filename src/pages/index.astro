---
import {Image} from "astro:assets"
import DefaultPage from "../layouts/DefaultPage.astro"
import MyPhoto from "../assets/me.png"
import MyPhoto2 from "../assets/me2.jpg"
import workMetroui from "../assets/works/metroui.jpg"
import workMinataur from "../assets/works/minataur.jpg"
import workKorzh from "../assets/works/korzh.jpg"
import workCrypto from "../assets/works/cryptoscamalert.jpg"
import workReserve from "../assets/works/reserve-plus.jpg"
import workPethealth from "../assets/works/pethealth.jpg"
import workMinaMonitor from "../assets/works/mina-monitor.jpg"
import workAiki from "../assets/works/aiki.jpg"
import workEasyTest from "../assets/works/easytest.jpg"
import workPanda from "../assets/works/panda.jpg"
---
<DefaultPage title="Sergey Pimenov's website">
	<div class="container-fluid">
        <div class="container">
            <div class="hero">
                <div class="row" style="--grid-gutter: 40px;">
                    <div class="cell-md-7 d-flex flex-justify-center flex-column order-2-fs order-1-md">
                        <h1 class="text-header"><small>I'm</small> Serhii Pimenov</h1>
                        <div class="text-subheader mt-6 mb-6">
                            <div>
                                I am a software engineer passionate about
                                <div class="d-inline-flex">
                                    <div data-role="typer" data-cursor="_" data-delete-delay=3000 data-splitter=";" class="text-bold fg-red">
                                        web development;
                                        creating web components;
                                        site development;
                                        site support and maintains;
                                        libraries and utils development;
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-6">
                            <a href="https://github.com/olton/olton/blob/master/cv-en.md" class="button warning rounded">My CV</a>
                            <a href="https://github.com/olton/olton/blob/master/cv-uk.md" class="button warning rounded">Моє Резюме</a>
                        </div>
                        <div class="mt-6 ani-flash text-bold fg-red">
                            [ OPEN FOR JOB OFFERS ]
                        </div>
                    </div>
                    <div class="cell-md-5 d-flex flex-align-center flex-justify-center order-1-fs order-2-md">
                        <div class="my-hero-photo">
                            <Image src={MyPhoto} alt="" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid accent-block" id="_about">
        <div class="container pt-20 pb-20">
            <div class="row">
                <div class="cell-lg-4 d-flex flex-align-center flex-justify-center">
                    <div class="box-photo">
                        <Image src={MyPhoto2} alt=""/>
                    </div>
                </div>
                <div class="cell-lg-7 pl-10-lg">
                    <div class="section-header about">
                        <div class="text-upper text-bold">[ About <span class="fg-orange">ME</span> ]</div>
                    </div>
                    <div class="mt-6">
                        Greetings! My name is Serhii Pimenov. I'm a web developer from Kyiv, Ukraine and I'm very passionate and committed to my work.
                        <div class="mt-4">I have more than 25 years of experience in a programmer and more than 10 of them is a professional web development.</div>
                        <div class="remark border-radius-20">
                            <div>
                                <ul class="my-data reduce-2 p-0">
                                    <li><label style="width: 80px;">Age:</label> <span id="_age">{new Date().getFullYear() - 1972}</span></li>
                                    <li><label style="width: 80px;">Place:</label> Київ, Україна</li>
                                    <li><label style="width: 80px;">Hobby:</label> German shepherds, shooting, music, fantasy</li>
                                    <li><label style="width: 80px;">Education:</label> Bachelor of law, Taurida Institute of MCL</li>
                                </ul>
                            </div>
                        </div>
                        <div class="mt-4">Currently I specialize in creating web components with HTML, JavaScript (TypeScript) and CSS, as well as sites using Astro and Metro UI.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid" id="_services">
        <div class="container pt-20 pb-20">
            <div>
                <div class="section-header services">
                    <div class="text-upper text-bold">[ MY <span class="fg-orange">SPECIALIZATION</span> ]</div>
                </div>
            </div>
            <div class="row mt-6" style="--grid-gutter: 40px;">
                <div class="cell-lg-4">
                    <div class="service-box">
                        <div class="service-box-inner">
                            <div class="service-icon"><span class="mif-designing"></span></div>
                            <div class="service-title">Web Development</div>
                            <div class="service-desc">Website and web component development.</div>
                        </div>
                    </div>
                </div>
                <div class="cell-lg-4">
                    <div class="service-box">
                        <div class="service-box-inner">
                            <div class="service-icon"><span class="mif-support_agent"></span></div>
                            <div class="service-title">Consulting</div>
                            <div class="service-desc">Consultations on the development and maintenance of sites, control of the implementation of technical specifications.</div>
                        </div>
                    </div>
                </div>
                <div class="cell-lg-4">
                    <div class="service-box">
                        <div class="service-box-inner">
                            <div class="service-icon"><span class="mif-roofing"></span></div>
                            <div class="service-title">Hosting</div>
                            <div class="service-desc">Publication of sites on trusted hosting, site maintenance.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid mt-20 mb-20 accent-block" id="_skills">
        <div class="container pt-10 pb-10">
            <div class="section-header services">
                <div class="text-upper text-bold text-center">[ MY <span class="fg-orange">SKILLS</span> ]</div>
            </div>
            <div class="row flex-justify-center mt-6">
                <div class="skill"></div>
                <div class="skill" title="javascript">
                    <span class="mif-javascript fg-orange"></span>
                </div>
                <div class="skill"></div>
                <div class="skill" title="git">
                    <img src="/images/Git.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill" title="typescript">
                    <span class="mif-typescript fg-teal"></span>
                </div>
                <div class="skill" title="rollup">
                    <img src="/images/Rollup.js.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill"></div>
                <div class="skill" title="sql">
                    <span class="mif-sql"></span>
                </div>
                <div class="skill"></div>
                <div class="skill"></div>
                <div class="skill" title="mysql">
                    <span class="mif-mysql fg-cyan"></span>
                </div>
                <div class="skill" title="jquery та m4q">
                    <img src="/images/jQuery.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill" title="Node.js">
                    <img src="/images/Node.js.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill" title="graphql">
                    <span class="mif-graphql fg-pink"></span>
                </div>
                <div class="skill" title="webpack">
                    <img src="/images/Windows%2011.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill" title="webpack">
                    <img src="/images/Linux.svg" />
                </div>
                <div class="skill" title="webpack">
                    <img src="/images/Webpack.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill" title="PostgreSQL">
                    <span class="mif-postgresql fg-cyan"></span>
                </div>
                <div class="skill"></div>
                <div class="skill" title="Html5">
                    <span class="mif-html5 fg-red"></span>
                </div>
                <div class="skill"></div>
                <div class="skill" title="Bash">
                    <img src="/images/Bash.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill" title="Angular">
                    <img src="/images/Angular.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill" title="React">
                    <img src="/images/React.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill" title="Rust">
                    <img src="/images/Rust.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill" title="Astro.build">
                    <img src="/images/Astro.svg" />
                </div>
                <div class="skill"></div>
                <div class="skill" title="Css3">
                    <span class="mif-css3 fg-green"></span>
                </div>
                <div class="skill" title="Less">
                    <img src="/images/Less.js.svg" />
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid mt-20 mb-20" id="_projects">
        <div class="container">
            <div class="section-header services">
                <div class="text-upper text-bold text-center">[ MY <span class="fg-orange">PROJECTS</span> ]</div>
            </div>
            <div class="text-center pl-20-md pr-20-md mt-6 mb-6">
               I enjoy every stage of the development process, from discussing the concept to direct execution, but I get the greatest pleasure when I see how the finished product does everything for you for what it was created for.
            </div>
            <div class="text-center reduce-2 text-muted">
                Below are examples of my work
            </div>
            <div class="row mt-10" style="--grid-gutter: 20px;">
                <div class="cell-md-3 cell-sm-6">
                    <div class="work-preview">
                        <div class="work-title">Main Project - Metro UI</div>
                        <a href="https://metroui.org.ua">
                            <Image src={workMetroui} alt="Metroui.org.ua" style="width: 100%; height: auto;"/>
                        </a>
                    </div>
                    <div class="arrow"><span class="mif-arrow-right mif-4x"></span></div>
                </div>
                <div class="cell-md-3 cell-sm-6">
                    <div class="work-preview">
                        <div class="work-title">Minataur.net</div>
                        <a href="https://minataur.net">
                            <Image src={workMinataur} alt="Minataur.net" style="width: 100%; height: auto;"/>
                        </a>
                    </div>
                    <div class="arrow"><span class="mif-arrow-right mif-4x"></span></div>
                </div>
                <div class="cell-md-3 cell-sm-6">
                    <div class="work-preview">
                        <div class="work-title">Korzh.com</div>
                        <a href="https://korzh.com">
                            <Image src={workKorzh} alt="Korzh.com" style="width: 100%; height: auto;"/>
                        </a>
                    </div>
                    <div class="arrow"><span class="mif-arrow-right mif-4x"></span></div>
                </div>
                <div class="cell-md-3 cell-sm-6">
                    <div class="work-preview">
                        <div class="work-title">CryptoScamAlert.com</div>
                        <a href="https://cryptoscamalert.com">
                            <Image src={workCrypto} alt="Korzh.com" style="width: 100%; height: auto;"/>
                        </a>
                    </div>
                    <div class="arrow"><span class="mif-arrow-right mif-4x"></span></div>
                </div>
                <div class="cell-md-3 cell-sm-6">
                    <div class="work-preview">
                        <div class="work-title">Panda (Templates)</div>
                        <a href="https://panda.metroui.org.ua">
                            <Image src={workPanda} alt="Panda" style="width: 100%; height: auto;"/>
                        </a>
                    </div>
                    <div class="arrow"><span class="mif-arrow-right mif-4x"></span></div>
                </div>
                <div class="cell-md-3 cell-sm-6">
                    <div class="work-preview">
                        <div class="work-title">Резерв+ (Site)</div>
                        <a href="https://reserveplus.mod.gov.ua/">
                            <Image src={workReserve} alt="Korzh.com" style="width: 100%; height: auto;"/>
                        </a>
                    </div>
                    <div class="arrow"><span class="mif-arrow-right mif-4x"></span></div>
                </div>
                <div class="cell-md-3 cell-sm-6">
                    <div class="work-preview">
                        <div class="work-title">Website of vet clinics</div>
                        <a href="https://pethealth.com.ua/">
                            <Image src={workPethealth} alt="Pethealth.com.ua" style="width: 100%; height: auto;"/>
                        </a>
                    </div>
                    <div class="arrow"><span class="mif-arrow-right mif-4x"></span></div>
                </div>
                <div class="cell-md-3 cell-sm-6">
                    <div class="work-preview">
                        <div class="work-title">Mina Monitor</div>
                        <a href="https://github.com/olton/mina-node-monitor">
                            <Image src={workMinaMonitor} alt="Mina Monitor" style="width: 100%; height: auto;"/>
                        </a>
                    </div>
                    <div class="arrow"><span class="mif-arrow-right mif-4x"></span></div>
                </div>
                <div class="cell-md-3 cell-sm-6">
                    <div class="work-preview">
                        <div class="work-title">Aiki.in.ua</div>
                        <a href="https://aiki.in.ua">
                            <Image src={workAiki} alt="Aiki.in.ua" style="width: 100%; height: auto;"/>
                        </a>
                    </div>
                    <div class="arrow"><span class="mif-arrow-right mif-4x"></span></div>
                </div>
                <div class="cell-md-3 cell-sm-6">
                    <div class="work-preview">
                        <div class="work-title">EasyTest</div>
                        <a href="https://easy.org.ua">
                            <Image src={workEasyTest} alt="Easy.org.ua" style="width: 100%; height: auto;"/>
                        </a>
                    </div>
                    <div class="arrow"><span class="mif-arrow-right mif-4x"></span></div>
                </div>
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-align-center flex-justify-center">
                    <div class="p-10">More projects on <a href="https://github.com/olton">GitHub<span>...</span></a></div>
                </div>
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-align-center flex-justify-center">
                    <div class="p-10">Maybe your site will be next?...</div>
                </div>
            </div>
            
            <div class="text-center reduce-2 text-muted mt-10">
                JavaScript Libraries
            </div>
            <div class="row mt-10 flex-justify-center" style="--grid-gutter: 20px;">
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-column flex-align-center flex-justify-center">
                    <div class="h3 m-0 pt-4"><a href="https://github.com/olton/guardian">Guardian</a></div>
                    <div class="p-4 text-center reduce-2">Set of methods and properties to create schemas for validation user input or other data.</div>
                    <div class="mb-4">
                        <a class="button small" href="https://github.com/olton/guardian"><span class="mif-github"></span></a>
                        <a class="button small" href="https://docs-new.metroui.org.ua/libraries/guardian/"><span class="mif-books"></span></a>
                    </div>
                </div>
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-column flex-align-center flex-justify-center">
                    <div class="h3 m-0 pt-4"><a href="https://github.com/olton/datetime">Datetime</a></div>
                    <div class="p-4 text-center reduce-2">Set of methods and properties for working with Dates and Time.</div>
                    <div class="mb-4">
                        <a class="button small" href="https://github.com/olton/datetime"><span class="mif-github"></span></a>
                        <a class="button small" href="https://docs-new.metroui.org.ua/libraries/datetime/"><span class="mif-books"></span></a>
                    </div>
                </div>
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-column flex-align-center flex-justify-center">
                    <div class="h3 m-0 pt-4"><a href="https://github.com/olton/string">String</a></div>
                    <div class="p-4 text-center reduce-2">set of methods and properties for working with Strings.</div>
                    <div class="mb-4">
                        <a class="button small" href="https://github.com/olton/string"><span class="mif-github"></span></a>
                        <a class="button small" href="https://docs-new.metroui.org.ua/libraries/string/"><span class="mif-books"></span></a>
                    </div>
                </div>
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-column flex-align-center flex-justify-center">
                    <div class="h3 m-0 pt-4"><a href="https://github.com/olton/hooks">Hooks</a></div>
                    <div class="p-4 text-center reduce-2">Set of functions to create user hooks.</div>
                    <div class="mb-4">
                        <a class="button small" href="https://github.com/olton/hooks"><span class="mif-github"></span></a>
                        <a class="button small" href="https://docs-new.metroui.org.ua/libraries/hooks/"><span class="mif-books"></span></a>
                    </div>
                </div>
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-column flex-align-center flex-justify-center">
                    <div class="h3 m-0 pt-4"><a href="https://github.com/olton/farbe">Farbe</a></div>
                    <div class="p-4 text-center reduce-2">Set of methods and properties for working with Colors.</div>
                    <div class="mb-4">
                        <a class="button small" href="https://github.com/olton/farbe"><span class="mif-github"></span></a>
                        <a class="button small" href="https://docs-new.metroui.org.ua/libraries/farbe/"><span class="mif-books"></span></a>
                    </div>
                </div>
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-column flex-align-center flex-justify-center">
                    <div class="h3 m-0 pt-4"><a href="https://github.com/olton/dom">Dom</a></div>
                    <div class="p-4 text-center reduce-2">Set of methods and properties for working with the HTML elements.</div>
                    <div class="mb-4">
                        <a class="button small" href="https://github.com/olton/dom"><span class="mif-github"></span></a>
                        <a class="button small" href="https://docs-new.metroui.org.ua/libraries/dom/"><span class="mif-books"></span></a>
                    </div>
                </div>
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-column flex-align-center flex-justify-center">
                    <div class="h3 m-0 pt-4"><a href="https://github.com/olton/html">Html</a></div>
                    <div class="p-4 text-center reduce-2">Create HTML pages in pure JavaScript!</div>
                    <div class="mb-4">
                        <a class="button small" href="https://github.com/olton/html"><span class="mif-github"></span></a>
                        <a class="button small" href="https://docs-new.metroui.org.ua/libraries/html/"><span class="mif-books"></span></a>
                    </div>
                </div>
            </div>
            
            <div class="text-center reduce-2 text-muted mt-10">
                Frameworks
            </div>
            <div class="row mt-10 flex-justify-center" style="--grid-gutter: 20px;">
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-column flex-align-center flex-justify-center">
                    <div class="h3 m-0 pt-4"><a href="https://github.com/olton/metroui">Metro UI</a></div>
                    <div class="p-4 text-center reduce-2">Metro UI is an free, open source, html-first toolkit for developing web sites with HTML, CSS, and JS.</div>
                    <div class="mb-4">
                        <a class="button small" href="https://github.com/olton/metroui"><span class="mif-github"></span></a>
                        <a class="button small" href="https://docs.metroui.org.ua/"><span class="mif-books"></span></a>
                    </div>
                </div>
                <div class="cell-md-3 cell-sm-6 border bd-orange border-radius-20 no-overflow d-flex flex-column flex-align-center flex-justify-center">
                    <div class="h3 m-0 pt-4"><a href="https://github.com/olton/easytest">EasyTest</a></div>
                    <div class="p-4 text-center reduce-2">Simple framework for testing JavaScript/TypeScript with enabled DOM.</div>
                    <div class="mb-4">
                        <a class="button small" href="https://github.com/olton/easytest"><span class="mif-github"></span></a>
                        <a class="button small" href="https://easy.org.ua/"><span class="mif-books"></span></a>
                    </div>
                </div>
            </div>
        </div>
