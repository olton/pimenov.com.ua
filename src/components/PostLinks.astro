---
import { datetime } from "@olton/datetime"
import { str } from "@olton/string"
const {posts} = Astro.props
console.log(posts)
---
<ul class="post-links">
    {posts.map(async p => {
        const { remarkPluginFrontmatter } = await p.render()
        return <li>
                <a href=`/blog/${p.slug}`>
                    <div class="d-flex flex-row flex-nowrap gap-4 flex-align-center">
                        <div class="post-link-image">
                            {p.data.cover && <img src={p.data.cover.src} alt={p.data.cover.alt} loading="lazy"/>}
                        </div>
                        <div>
                            {p.data.title}
                            <div class="text-light reduce-3 mt-1 mb-1">{str(p.data.description).truncateWithAlign(150)}...</div>
                        </div>
                    </div>
                    <div class="d-flex flex-row flex-nowrap mt-4">
                        <span class="reduce-2 text-normal">{remarkPluginFrontmatter.time}</span>
                        <span class="ml-auto reduce-2">{datetime(p.data.date).format("DD, MMM YYYY")}</span>
                    </div>
                </a>
            </li>
    })}
</ul>
